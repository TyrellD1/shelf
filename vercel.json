{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build -w ui && npm run build -w web",
  "outputDirectory": "ui/dist",
  "regions": ["iad1"],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "web/dist/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/mcp", "destination": "/api" },
    { "source": "/cli", "destination": "/api" },
    { "source": "/cli/(.*)", "destination": "/api" },
    { "source": "/oauth/(.*)", "destination": "/api" },
    { "source": "/.well-known/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
