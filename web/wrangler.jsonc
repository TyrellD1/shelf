{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shelf",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../ui/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/cli", "/cli/*", "/login", "/logout"]
  },
  // Production database: `npx wrangler hyperdrive create shelf-db --connection-string "<neon url>"`
  // then paste the printed id here. Local dev does not need it — put DATABASE_URL in .dev.vars.
  // "hyperdrive": [
  //   {
  //     "binding": "HYPERDRIVE",
  //     "id": "<hyperdrive-id>",
  //     "localConnectionString": "postgres://shelf@127.0.0.1:55432/shelf"
  //   }
  // ],
  "vars": {
    "APP_URL": "http://localhost:8787"
  }
}
