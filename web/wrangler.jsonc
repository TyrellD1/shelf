{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shelf",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../ui/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/cli",
      "/cli/*",
      "/login",
      "/logout",
      "/mcp",
      "/oauth/*",
      "/.well-known/*"
    ]
  },
  // Production database. `npx wrangler hyperdrive create shelf-db --connection-string "<neon direct url>"`
  // printed this id. Use the direct (non-pooled) Neon URL: Hyperdrive does the pooling,
  // and Neon advises against running both. `localConnectionString` keeps `wrangler dev`
  // on the local Postgres, so local work never touches production data.
  // Its query cache must stay off (`wrangler hyperdrive update <id> --caching-disabled true`):
  // with it on, a read made while registering an MCP client is replayed for a minute, and
  // the authorize step that follows fails with `invalid_target`.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "b748489d3fe04e898d99c8c72c32c20d",
      // The local Postgres trusts local connections, so this password is only here because
      // `wrangler dev` refuses a `localConnectionString` without one (see scripts/dev-db.sh).
      "localConnectionString": "postgres://shelf:shelf@127.0.0.1:55432/shelf"
    }
  ],
  "vars": {
    // The origin the app is served from. Cookies and the CLI login redirect are built
    // from it, so it must match the URL people actually open. `.dev.vars` overrides it
    // to http://localhost:8787 for local work.
    "APP_URL": "https://shelf.sftwr.workers.dev"
  }
}
